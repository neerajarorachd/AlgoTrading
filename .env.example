# SQL Server (real broker-fed data, final verification) — use an SSH tunnel:
# ssh -L 1433:localhost:1433 <user>@<azure-vm> -N
# Never put the Azure public IP in this connection string.
DB_CONNECTION_STRING=mssql+pyodbc://algo_app:REPLACE_WITH_PASSWORD@localhost:1433/trading_db?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# Local dev/testing without the VM/tunnel — swap the line above for this one:
# DB_CONNECTION_STRING=sqlite:///local_dev.db
