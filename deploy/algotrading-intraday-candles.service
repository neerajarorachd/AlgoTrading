[Unit]
Description=AlgoTrading intraday candle update (1/3/5-min in candles_historical, gap-fills per timeframe)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/AlgoTrading/backend
ExecStartPre=%h/AlgoTrading/wait_for_sqlserver.sh
ExecStart=%h/AlgoTrading/venv/bin/python3 -u scripts/update_intraday_candles.py
StandardOutput=append:%h/AlgoTrading/intraday_candles.log
StandardError=append:%h/AlgoTrading/intraday_candles.log
TimeoutStartSec=3000
